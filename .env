# ── Docker Compose variable substitution ──────────────────────────────────────
# This file is loaded automatically by docker-compose.yml (it sits in the same
# directory). It supplies the ${POSTGRES_*} variables used for:
#   - the postgres service's POSTGRES_USER/PASSWORD/DB environment
#   - the backend's DATABASE_URL connection string
#   - the postgres healthcheck command
#
# Keep these values in sync with POSTGRES_USER/PASSWORD/DB in api/.env.
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=imsuser
POSTGRES_PASSWORD=imspass
POSTGRES_DB=imsdb

# New Relic license key — used by the newrelic-infra container
NEW_RELIC_LICENSE_KEY=e6bac3cba17dce4a8b7ad71358a205ffd2ffNRAL
